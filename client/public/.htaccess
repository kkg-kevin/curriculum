# Portal (dcf.digifunzi.com, and the Dev portal) — copied into the build by Vite (client/public).
# 17 Nov 2026: the old file (only the four routing lines below) plus browser caching.

Options -MultiViews
RewriteEngine On
# A missing file under /assets/ (an old build's page file) is a plain 404, so an open tab notices
# and reloads (routes/lazyPage.jsx) instead of being handed the portal's start page.
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]

<IfModule mod_headers.c>
  # Built files carry a content fingerprint in their name (index-C-LlhVce.js): a new build always
  # gets new names, so browsers may keep these for a year without asking again.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The start page is always checked, so a new release is picked up on the next visit.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
